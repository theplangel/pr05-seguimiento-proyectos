# Plantilla SIN credenciales reales. No la uses tal cual: genera tu .env con  ./scripts/generar-env.sh
# (o rellena cada valor a mano). El archivo .env NO se versiona (.gitignore).

# Contraseña de PostgreSQL
DB_PASSWORD=
# Clave del dispositivo IoT (cabecera X-API-Key)
IOT_API_KEY=
# Usuarios de la aplicación (se crean al primer arranque con BCrypt). Contraseñas de 12 o más caracteres.
APP_LIDER_USUARIO=lider
APP_LIDER_PASSWORD=
APP_INTEGRANTE_USUARIO=integrante
APP_INTEGRANTE_PASSWORD=

# Opcionales
# demo = ciclo con todas las alertas; normal = temperatura estable
ESCENARIO=demo
# true solo en desarrollo: habilita Swagger UI en http://localhost:8080/swagger-ui.html
SWAGGER_ENABLED=false
